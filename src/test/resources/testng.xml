<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="API Tests Suite" parallel="classes" thread-count="4">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Create Entity Tests">
        <classes>
            <class name="tests.CreateEntityTest"/>
        </classes>
    </test>

    <test name="Read Entity Tests">
        <classes>
            <class name="tests.ReadEntityTest"/>
        </classes>
    </test>

    <test name="Update Entity Tests">
        <classes>
            <class name="tests.UpdateEntityTest"/>
        </classes>
    </test>

    <test name="Delete Entity Tests">
        <classes>
            <class name="tests.DeleteEntityTest"/>
        </classes>
    </test>

</suite>
